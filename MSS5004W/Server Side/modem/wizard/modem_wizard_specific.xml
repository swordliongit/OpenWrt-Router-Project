<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard's Action-->
        <record id="modem_wizard_specific_action" model="ir.actions.act_window">
            <field name="name">Spesifik Alan Güncelle</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">modem.wizard.specific</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <!-- Wizard's view-->
        <record id="modem_wizard_specific_view" model="ir.ui.view">
            <field name="name">modem.wizard.specific.form</field>
            <field name="model">modem.wizard.specific</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="action"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Save" name="update_modem_specific_information" type="object" class="btn-primary"/>
                        <button string="Reject" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>