<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- This record defines the scheduler (ir.cron) job -->
        <record id="ir_cron_cmm_outlier_detector" model="ir.cron">
            <field name="name">Outlier Modem Detector</field>
            <field name="model_id" ref="model_modem_profile_site" />
            <field name="state">code</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False" />
            <field name="priority">1</field>
            <field name="user_id" ref="base.user_root" />
            <field name="code">
                model.cron_outlier_detector()
            </field>
        </record>
